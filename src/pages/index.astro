---
/**
 * Portafolio 3D Interactivo - Landing Page Cinematográfica (Astro + Three.js + Lenis)
 * Basado en las especificaciones maestras de PRODUCT.md y Portafolio.md
 */
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Luis Monge — Científico de Datos · Arquitecto IA & Datos · Software</title>
    <meta
      name="description"
      content="Portafolio 3D interactivo de Luis Monge: Científico de Datos, Arquitecto de Soluciones (IA & Datos) y Desarrollador de Software."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Canvas WebGL fijo de fondo -->
    <canvas id="scene"></canvas>

    <!-- Monograma Iniciales Flotante Superior Izquierdo (LM) -->
    <button
      type="button"
      id="brand-logo"
      class="brand-logo-btn"
      aria-label="Luis Monge — Volver al inicio"
      title="Luis Monge — Inicio"
    >
      <span class="brand-monogram">LM</span>
      <span class="brand-dot"></span>
    </button>

    <!-- Selector de Idioma Flotante Superior Derecho (ES / EN) -->
    <button
      type="button"
      id="lang-toggle"
      class="lang-toggle-btn"
      aria-label="Switch language between Spanish and English"
      title="Cambiar idioma / Switch language"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10" />
        <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
        <path d="M2 12h20" />
      </svg>
      <span class="lang-opt active" data-lang-code="es">ES</span>
      <span class="lang-divider">/</span>
      <span class="lang-opt" data-lang-code="en">EN</span>
    </button>

    <!-- Contenedor de Scroll de 9 Secciones Narrativas -->
    <main id="scroll-container">
      <!-- 00. Hero Section -->
      <section class="story-section active" data-index="0" id="sec-hero">
        <div class="content-wrapper">
          <div class="hero-kicker" data-i18n="hero_kicker">ESTRATEGIA · INTELIGENCIA ARTIFICIAL · DATOS</div>
          <h1 class="hero-title">LUIS<br />MONGE</h1>
          <div class="hero-roles" aria-label="Especialidades principales">
            <span class="role-badge" data-i18n="hero_role_1">Científico de Datos</span>
            <span class="role-separator">·</span>
            <span class="role-badge" data-i18n="hero_role_2">Arquitecto de Soluciones (IA &amp; Datos)</span>
            <span class="role-separator">·</span>
            <span class="role-badge" data-i18n="hero_role_3">Desarrollo de Software</span>
          </div>
          <div class="hero-links">
            <button
              type="button"
              class="social-pill email-pill"
              id="copy-email-btn"
              data-email="monjeje2028@gmail.com"
              aria-label="Copiar correo monjeje2028@gmail.com al portapapeles"
              title="Click para copiar al portapapeles"
            >
              <span class="icon-wrap">
                <svg class="email-icon mail-svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="16" x="2" y="4" rx="2" />
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                </svg>
                <svg class="email-icon check-svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              </span>
              <span class="email-label">monjeje2028@gmail.com</span>
              <span class="copy-hint" data-i18n="copy_hint">COPIAR</span>
            </button>
            <a
              href="https://github.com/LuisMonGP"
              target="_blank"
              rel="noopener noreferrer"
              class="social-pill"
              aria-label="Perfil de GitHub de Luis Monge"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
              </svg>
              <span>GitHub</span>
            </a>
            <a
              href="https://www.linkedin.com/in/luis-monge-5609ba224"
              target="_blank"
              rel="noopener noreferrer"
              class="social-pill"
              aria-label="Perfil de LinkedIn de Luis Monge"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
              <span>LinkedIn</span>
            </a>
          </div>
        </div>
      </section>

      <!-- 01. Sección 01: La Presentación Global (Busto de Mármol) -->
      <section class="story-section" data-index="1" id="sec-marmol">
        <div class="content-wrapper">
          <div class="section-kicker" data-i18n="s1_kicker">01. QUIÉN SOY · ¿UN PERFIL ANALÍTICO?</div>
          <h2 class="section-title" data-i18n-html="s1_title">EL ARQUITECTO<br />DETRÁS DEL SISTEMA</h2>
          <div class="section-paragraphs">
            <p class="section-body" data-i18n-html="s1_p1">
              Arquitecto de Soluciones de IA y Científico de Datos especializado en el diseño, evaluación y despliegue de <strong>sistemas autónomos multi-agente</strong> y <strong>pipelines analíticos a escala de producción</strong>.
            </p>
            <p class="section-body" data-i18n-html="s1_p2">
              Mi enfoque parte del <strong>análisis</strong> y de una <strong>visión panorámica</strong>: abordo cada problema desde una perspectiva externa e integradora para descubrir los patrones invisibles que conectan áreas dispares, creando un espacio donde la complejidad y la incertidumbre se transforman, con <strong>visión ejecutiva y criterio humano</strong>, en ecosistemas sólidos y escalables.
            </p>
            <p class="section-body" data-i18n-html="s1_p3">
              Complementamos el rigor técnico con un <strong>liderazgo basado en la empatía y la comunicación asertiva</strong>, alineando talentos multidisciplinarios e impulsando decisiones estratégicas con confianza y propósito.
            </p>
          </div>
        </div>
      </section>

      <!-- 02. Sección 02: Introducción a Habilidades Técnicas & Era Agéntica (El Caballo) -->
      <section class="story-section" data-index="2" id="sec-caballo">
        <div class="content-wrapper">
          <div class="section-kicker" data-i18n="s2_kicker">02. HABILIDADES TÉCNICAS · LAS PIEZAS</div>
          <h2 class="section-title" data-i18n-html="s2_title">INGENIERÍA<br />&amp; CIENCIAS</h2>
          <p class="section-body" data-i18n-html="s2_body">
            Mi perfil tiende el puente entre la <strong>experimentación científica</strong> y los <strong>sistemas de producción reales</strong>. A partir de aquí, cada pieza revela una dimensión técnica diseñada para construir inteligencia artificial confiable, auditable y de alta disponibilidad.
          </p>
          <div class="pillar-list" aria-label="Ejes de vanguardia agéntica">
            <div class="pillar-item">
              <span class="pillar-title" data-i18n-html="s2_c1_t">Orquestación Agéntica &amp; Ecosistemas MCP</span>
              <span class="pillar-desc" data-i18n-html="s2_c1_d">Diseño de flujos multi-agente (planificación, delegación y memoria) desacoplados mediante <strong>Model Context Protocol (MCP)</strong> y librerías de <strong>Skills</strong> atómicas reutilizables.</span>
            </div>
            <div class="pillar-item">
              <span class="pillar-title" data-i18n-html="s2_c2_t">Harness Engineering &amp; Prompting Sistemático</span>
              <span class="pillar-desc" data-i18n-html="s2_c2_d">Entornos de evaluación automatizados (<em>AI Evals &amp; Sandboxes</em>), <em>guardrails</em> dinámicos y esquemas deterministas que mitigan alucinaciones y controlan latencia y costos.</span>
            </div>
          </div>
          <div class="skill-tags">
            <span class="skill-chip">Multi-Agent Orchestration</span>
            <span class="skill-chip">MCP Protocol</span>
            <span class="skill-chip">Atomic Skills</span>
            <span class="skill-chip">Evaluation Harnesses</span>
            <span class="skill-chip">CRISP-DM</span>
          </div>
        </div>
      </section>

      <!-- 03. Sección 03: Ingeniería de Software de Calidad & MLOps (La Torre) -->
      <section class="story-section" data-index="3" id="sec-torre">
        <div class="content-wrapper">
          <div class="section-kicker" data-i18n="s3_kicker">03. LA TORRE · ESTRUCTURA</div>
          <h2 class="section-title" data-i18n-html="s3_title">INGENIERÍA<br />DE SOFTWARE</h2>
          <p class="section-body" data-i18n-html="s3_body">
            Un modelo o agente sólo genera valor real cuando se sustenta sobre <strong>arquitectura limpia, pruebas rigurosas y despliegues reproducibles</strong>.
          </p>
          <div class="pillar-list" aria-label="Competencias de Ingeniería de Software y MLOps">
            <div class="pillar-item">
              <span class="pillar-title" data-i18n-html="s3_c1_t">Arquitectura Modular &amp; Calidad de Código</span>
              <span class="pillar-desc" data-i18n-html="s3_c1_d">Diseño bajo pilares sólidos de <strong>POO</strong> (abstracción, herencia, encapsulamiento y polimorfismo) y pruebas unitarias automatizadas con <code>pytest</code>.</span>
            </div>
            <div class="pillar-item">
              <span class="pillar-title" data-i18n-html="s3_c2_t">APIs de Alto Rendimiento &amp; Contenedores</span>
              <span class="pillar-desc" data-i18n-html="s3_c2_d">Microservicios asíncronos de baja latencia con <code>FastAPI</code>, validación estricta de contratos y esquemas de datos con <code>Pydantic</code>, y contenedorización escalable en <code>Docker</code>.</span>
            </div>
            <div class="pillar-item">
              <span class="pillar-title" data-i18n-html="s3_c3_t">Persistencia Híbrida SQL &amp; NoSQL</span>
              <span class="pillar-desc" data-i18n-html="s3_c3_d">Gestión de datos no estructurados, documentales y vectoriales en <code>MongoDB</code> (<code>PyMongo</code>) junto a bases relacionales SQL, integradas bajo el ciclo de vida <code>CRISP-DM</code>.</span>
            </div>
          </div>
          <div class="tech-tag" data-i18n="s3_tag">ESCALABILIDAD / SEGURIDAD</div>
        </div>
      </section>

      <!-- 04. Sección 04: Ciencia de Datos, ML & Computación Científica (El Alfil) -->
      <section class="story-section" data-index="4" id="sec-alfil">
        <div class="content-wrapper">
          <div class="section-kicker" data-i18n="s4_kicker">04. EL ALFIL · OBSERVACIÓN</div>
          <h2 class="section-title" data-i18n-html="s4_title">CIENCIA<br />DE DATOS</h2>
          <p class="section-body" data-i18n-html="s4_body">
            Desde la vectorización matemática y el modelado estadístico hasta redes profundas e <strong>interpretabilidad algorítmica</strong>.
          </p>
          <div class="pillar-list" aria-label="Competencias de Ciencia de Datos">
            <div class="pillar-item">
              <span class="pillar-title" data-i18n-html="s4_c1_t">Machine Learning Avanzado &amp; Explicabilidad (XAI)</span>
              <span class="pillar-desc" data-i18n-html="s4_c1_d">Pipelines predictivos con <code>Scikit-Learn</code>, ingeniería de características avanzada, búsqueda bayesiana con <code>Optuna</code>, AutoML (<code>PyCaret</code>, <code>TPOT</code>) e interpretabilidad con <code>SHAP</code> y <code>LIME</code>.</span>
            </div>
            <div class="pillar-item">
              <span class="pillar-title" data-i18n-html="s4_c2_t">NLP &amp; Deep Learning</span>
              <span class="pillar-desc" data-i18n-html="s4_c2_d">Representación semántica y <em>embeddings</em> con <code>spaCy</code>, Redes Convolucionales (CNN) y arquitecturas <em>Transformers</em> con <em>Transfer Learning</em> y <em>Fine-Tuning</em> en <code>Hugging Face</code>.</span>
            </div>
            <div class="pillar-item">
              <span class="pillar-title" data-i18n-html="s4_c3_t">Computación Científica &amp; Big Data</span>
              <span class="pillar-desc" data-i18n-html="s4_c3_d">Cómputo vectorial (<code>NumPy</code>, <code>Pandas</code>), <em>profiling</em> de CPU/RAM (<code>cProfile</code>, <code>memory_profiler</code>), análisis geoespacial (<code>GeoPandas</code>), estadística (<code>Statsmodels</code>, <code>SciPy</code>) y cómputo distribuido (<code>Dask</code>, <code>PySpark</code>).</span>
            </div>
          </div>
          <div class="tech-tag" data-i18n="s4_tag">ANÁLISIS PREDICTIVO / ANÁLISIS PRESCRIPTIVO / PRECISIÓN</div>
        </div>
      </section>

      <!-- 05. Sección 05: Diseño, Full-Stack & Herramientas Extra (La Reina) -->
      <section class="story-section" data-index="5" id="sec-reina">
        <div class="content-wrapper">
          <div class="section-kicker" data-i18n="s5_kicker">05. LA REINA · DISEÑO &amp; WEB</div>
          <h2 class="section-title" data-i18n-html="s5_title">PRODUCTO Y<br />VISUALIZACIÓN</h2>
          <p class="section-body" data-i18n-html="s5_body">
            <strong>Diseño de soluciones creativas</strong>, dinámicas operativas, fricciones de usuario y flujos de trabajo reales (sin sobre-ingeniería) para diseñar herramientas y agentes que se adaptan orgánicamente a las personas, y no al revés.
          </p>
          <div class="pillar-list" aria-label="Competencias de Diseño, Desarrollo Web y Herramientas">
            <div class="pillar-item">
              <span class="pillar-title" data-i18n-html="s5_c1_t">Diseño UX/UI &amp; Visualización Ejecutiva</span>
              <span class="pillar-desc" data-i18n-html="s5_c1_d"><em>UX Research</em>, sistemas de diseño en <code>Figma</code>, especificación en <code>design.md</code>, patrones de diseño de interfaz y narrativas visuales de negocio con <code>Power BI</code>.</span>
            </div>
            <div class="pillar-item">
              <span class="pillar-title" data-i18n-html="s5_c2_t">Desarrollo Full-Stack &amp; Frameworks Modernos</span>
              <span class="pillar-desc" data-i18n-html="s5_c2_d">Construcción de aplicaciones e interfaces de alto impacto con <code>TypeScript</code>, <code>JavaScript</code>, <code>C#</code> y <code>Node.js</code>, impulsadas por frameworks como <code>Next.js</code> y <code>Astro</code>.</span>
            </div>
            <div class="pillar-item">
              <span class="pillar-title" data-i18n-html="s5_c3_t">Entornos Agénticos, Herramientas &amp; Gestión</span>
              <span class="pillar-desc" data-i18n-html="s5_c3_d">Control de versiones con <code>Git</code> y <code>Bash</code>, entornos agénticos (<code>Hermes</code>, <code>OpenCode</code>), gestión de producto en <code>Obsidian</code> y liderazgo bajo metodologías <strong>Ágiles</strong>.</span>
            </div>
          </div>
          <div class="tech-tag" data-i18n="s5_tag">DESIGN THINKING / PATRONES DE DISEÑO / STORYTELLING</div>
        </div>
      </section>

      <!-- 06. Sección 06: Habilidades Blandas & Intereses (El Rey) -->
      <section class="story-section" data-index="6" id="sec-rey">
        <div class="content-wrapper">
          <div class="section-kicker" data-i18n="s6_kicker">06. EL REY · AUTOCONOCIMIENTO</div>
          <h2 class="section-title" data-i18n-html="s6_title">HABILIDADES<br />BLANDAS</h2>
          <div class="king-clusters">
            <div class="king-pills">
              <span class="king-pill king-pill-gold" data-i18n="s6_ss_1">Liderazgo</span>
              <span class="king-pill king-pill-gold" data-i18n="s6_ss_2">Observación</span>
              <span class="king-pill king-pill-gold" data-i18n="s6_ss_3">Inteligencia Emocional</span>
              <span class="king-pill king-pill-gold" data-i18n="s6_ss_4">Comunicación Asertiva</span>
              <span class="king-pill king-pill-gold" data-i18n="s6_ss_5">Empatía</span>
            </div>
            <div class="king-group">
              <span class="king-group-label" data-i18n="s6_int_label">INTERESES</span>
              <div class="king-pills">
                <span class="king-pill" data-i18n="s6_int_1">Automatizaciones</span>
                <span class="king-pill" data-i18n="s6_int_2">Novedades Tecnológicas</span>
                <span class="king-pill" data-i18n="s6_int_3">Desarrollo Personal</span>
                <span class="king-pill" data-i18n="s6_int_4">Psicología</span>
                <span class="king-pill" data-i18n="s6_int_5">Filosofía</span>
                <span class="king-pill" data-i18n="s6_int_6">Religión</span>
                <span class="king-pill" data-i18n="s6_int_7">Mindfulness</span>
                <span class="king-pill" data-i18n="s6_int_8">Neurociencia</span>
                <span class="king-pill" data-i18n="s6_int_9">Metafísica</span>
                <span class="king-pill" data-i18n="s6_int_10">Metacognición</span>
                <span class="king-pill" data-i18n="s6_int_11">PNL</span>
              </div>
            </div>
            <blockquote class="king-quote" data-i18n="s6_quote">
              «La tecnología más poderosa sigue siendo la conciencia: observar nuestro propio algoritmo para transformar el pensamiento en acción, y la acción en un digno futuro.»
            </blockquote>
          </div>
          <div class="tech-tag" data-i18n="s6_tag">CUERPO, ALMA Y MENTE / PENSAMIENTO PROFUNDO</div>
        </div>
      </section>

      <!-- 07. El Peón: Repositorios Clave de Código Abierto -->
      <section class="story-section" data-index="7" id="sec-peon">
        <div class="content-wrapper">
          <div class="section-kicker" data-i18n="s7_kicker">07. EL PEÓN · REPOSITORIO</div>
          <h2 class="section-title" data-i18n-html="s7_title">PROYECTOS<br />DESTACADOS</h2>

          <div class="project-list">
            <!-- Repo 1: Movilidad Urbana -->
            <a
              href="https://github.com/LuisMonGP/optimizacion-flota-movilidad-urbana"
              target="_blank"
              rel="noopener noreferrer"
              class="project-card"
            >
              <div class="project-header">
                <span class="project-repo">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                  </svg>
                  <span class="project-slug">LuisMonGP / <strong>optimizacion-flota-movilidad-urbana</strong></span>
                </span>
                <span class="project-badge" data-i18n="s7_p1_badge">BIG DATA / GEOPANDAS</span>
              </div>
              <p class="project-desc" data-i18n-html="s7_p1_d">
                Ingesta y analítica geoespacial sobre 144k+ viajes (Divvy Chicago). Clases POO, vectorización matemática Haversine con <code>NumPy</code> y suites de test en <code>pytest</code>.
              </p>
              <div class="project-stack">
                <span>Python</span>
                <span>NumPy</span>
                <span>GeoPandas</span>
                <span>pytest</span>
                <span>CI/CD</span>
              </div>
            </a>

            <!-- Repo 2: Riesgo Crediticio & Explicabilidad -->
            <a
              href="https://github.com/LuisMonGP/riesgo-crediticio-clustering-explicabilidad"
              target="_blank"
              rel="noopener noreferrer"
              class="project-card"
            >
              <div class="project-header">
