      .email-pill.copied {
        border-color: rgba(134, 239, 172, 0.55);
        background: rgba(16, 40, 28, 0.7);
        color: #ffffff;
        box-shadow: 0 0 18px rgba(134, 239, 172, 0.3);
      }

      .email-pill.copied .mail-svg {
        display: none;
      }

      .email-pill.copied .check-svg {
        display: inline-block;
      }

      .email-pill.copied .copy-hint {
        background: rgba(134, 239, 172, 0.25);
        color: #86efac;
      }

      /* Tipografía Secciones Narrativas */
      .section-kicker {
        font-family: 'Inter', monospace;
        font-size: 0.70rem;
        font-weight: 500;
        letter-spacing: 0.20em;
        text-transform: uppercase;
        color: var(--accent-blue);
        opacity: 0.88;
        margin-bottom: -6px;
      }

      .section-title {
        font-family: 'Cinzel', 'Playfair Display', serif;
        font-size: clamp(2.4rem, 4.4vw, 4.2rem);
        font-weight: 500;
        line-height: 1.05;
        letter-spacing: 0.03em;
        color: #f8fafc;
        text-shadow: 0 0 35px rgba(255, 255, 255, 0.12);
      }

      .section-paragraphs {
        display: flex;
        flex-direction: column;
        gap: 14px;
      }

      .section-body {
        font-size: clamp(0.95rem, 1.08vw, 1.12rem);
        font-weight: 300;
        line-height: 1.62;
        color: #94a3b8;
        max-width: 40vw;
      }

      .section-body strong {
        color: #e2e8f0;
        font-weight: 500;
      }

      .pillar-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
        max-width: 39vw;
      }

      .pillar-item {
        display: flex;
        flex-direction: column;
        gap: 3px;
        padding: 11px 16px;
        border-radius: 14px;
        background: rgba(10, 14, 22, 0.55);
        border: 1px solid rgba(255, 255, 255, 0.10);
        border-left: 2px solid rgba(147, 197, 253, 0.55);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      }

      .pillar-title {
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        color: #f1f5f9;
      }

      .pillar-desc {
        font-size: 0.81rem;
        font-weight: 300;
        line-height: 1.5;
        color: #94a3b8;
      }

      .pillar-desc strong {
        color: #e2e8f0;
        font-weight: 500;
      }

      .pillar-desc code {
        font-family: 'Inter', monospace;
        font-size: 0.75rem;
        font-weight: 500;
        color: #bfdbfe;
        background: rgba(147, 197, 253, 0.10);
        border: 1px solid rgba(147, 197, 253, 0.22);
        border-radius: 6px;
        padding: 1px 6px;
      }

      .skill-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        max-width: 39vw;
        padding-top: 2px;
      }

      .skill-chip {
        font-family: 'Inter', monospace;
        font-size: 0.68rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #cbd5e1;
        padding: 4px 11px;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.14);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
      }

      /* Bloques Especiales de El Rey (Habilidades Blandas & Intereses sin párrafo) */
      .king-clusters {
        display: flex;
        flex-direction: column;
        gap: 18px;
        max-width: 40vw;
        padding-top: 4px;
      }

      .king-group {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 14px 18px;
        border-radius: 16px;
        background: rgba(10, 14, 22, 0.58);
        border: 1px solid rgba(255, 255, 255, 0.10);
        border-left: 2px solid rgba(224, 173, 80, 0.65);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
      }

      .king-group-label {
        font-family: 'Inter', monospace;
        font-size: 0.70rem;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #f8fafc;
      }

      .king-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .king-pill {
        font-family: 'Inter', sans-serif;
        font-size: 0.78rem;
        font-weight: 400;
        letter-spacing: 0.03em;
        color: #cbd5e1;
        padding: 5px 13px;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.14);
        transition: transform 0.2s ease, border-color 0.2s ease, color 0.2s ease;
      }

      .king-pill-gold {
        color: #fef3c7;
        font-weight: 500;
        background: rgba(224, 173, 80, 0.10);
        border-color: rgba(224, 173, 80, 0.35);
      }

      .king-quote {
        font-family: 'Cinzel', 'Playfair Display', serif;
        font-size: clamp(0.84rem, 0.96vw, 0.98rem);
        font-weight: 400;
        line-height: 1.58;
        letter-spacing: 0.02em;
        color: #fde68a;
        opacity: 0.92;
        padding-left: 14px;
        border-left: 2px solid rgba(224, 173, 80, 0.55);
      }

      /* Tarjetas de Proyectos GitHub (El Peón) */
      .project-list {
        display: flex;
        flex-direction: column;
        gap: 11px;
        max-width: 40vw;
        padding-top: 2px;
      }

      .project-card {
        display: flex;
        flex-direction: column;
        gap: 7px;
        padding: 13px 17px;
        border-radius: 16px;
        background: rgba(10, 14, 22, 0.62);
        border: 1px solid rgba(255, 255, 255, 0.11);
        border-left: 2px solid rgba(147, 197, 253, 0.65);
        text-decoration: none;
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
      }

      .project-card:hover {
        transform: translateY(-2px) translateX(3px);
        background: rgba(16, 23, 36, 0.78);
        border-color: rgba(147, 197, 253, 0.40);
        border-left-color: #93c5fd;
        box-shadow: 0 10px 26px rgba(0, 0, 0, 0.45), 0 0 16px rgba(147, 197, 253, 0.16);
      }

      .project-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
      }

      .project-repo {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #94a3b8;
        font-family: 'Inter', monospace;
        font-size: 0.78rem;
      }

      .project-repo svg {
        color: #cbd5e1;
        flex-shrink: 0;
      }

      .project-slug strong {
        color: #f8fafc;
        font-weight: 600;
      }

      .project-badge {
        font-family: 'Inter', monospace;
        font-size: 0.62rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #93c5fd;
        padding: 3px 9px;
        border-radius: 9999px;
        background: rgba(147, 197, 253, 0.10);
        border: 1px solid rgba(147, 197, 253, 0.25);
      }

      .project-desc {
        font-size: 0.80rem;
        font-weight: 300;
        line-height: 1.48;
        color: #94a3b8;
      }

      .project-desc code {
        font-family: 'Inter', monospace;
        font-size: 0.73rem;
        font-weight: 500;
        color: #bfdbfe;
        background: rgba(147, 197, 253, 0.10);
        border: 1px solid rgba(147, 197, 253, 0.22);
        border-radius: 5px;
        padding: 1px 5px;
      }

      .project-stack {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        padding-top: 2px;
      }

      .project-stack span {
        font-family: 'Inter', monospace;
        font-size: 0.65rem;
        font-weight: 500;
        letter-spacing: 0.06em;
        color: #cbd5e1;
        padding: 2px 8px;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.12);
      }

      .project-footer {
        display: flex;
        align-items: center;
        padding-top: 2px;
      }

      .project-more-link {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 8px 16px;
        border-radius: 9999px;
        background: rgba(147, 197, 253, 0.08);
        border: 1px solid rgba(147, 197, 253, 0.28);
        color: #e2e8f0;
        font-family: 'Inter', monospace;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-decoration: none;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        transition: color 0.25s ease, background 0.25s ease, border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
      }

      .project-more-link:hover {
        color: #ffffff;
        background: rgba(147, 197, 253, 0.18);
        border-color: rgba(147, 197, 253, 0.55);
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4), 0 0 14px var(--glass-glow);
      }

      .project-more-link:hover .cta-arrow {
        transform: translateX(4px);
      }

      .tech-tag {
        font-family: 'Inter', monospace;
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #64748b;
        padding-top: 4px;
      }

      /* Estilos para el Tablero 3D Interactivo & HUD */
      .final-actions-row {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
      }

      .cta-board-btn {
        background: rgba(56, 189, 248, 0.08);
        border-color: rgba(56, 189, 248, 0.28);
        color: #38bdf8;
        cursor: pointer;
      }

      .cta-board-btn:hover {
        background: rgba(56, 189, 248, 0.18);
        border-color: rgba(56, 189, 248, 0.55);
        box-shadow: 0 8px 24px rgba(56, 189, 248, 0.25);
      }

      .board-hud {
        position: fixed;
        bottom: 24px;
        left: 50%;
        transform: translateX(-50%) translateY(40px);
        opacity: 0;
        pointer-events: none;
        z-index: 80;
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
      }

      .board-hud.active {
        opacity: 1;
        pointer-events: auto;
        transform: translateX(-50%) translateY(0);
      }

      .board-hud-panel {
        display: flex;
        align-items: center;
        gap: 20px;
        background: rgba(7, 9, 14, 0.88);
        border: 1px solid rgba(56, 189, 248, 0.35);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        padding: 12px 20px;
        border-radius: 9999px;
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6), 0 0 24px rgba(56, 189, 248, 0.15);
      }

      .board-hud-info {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .board-hud-icon {
        font-size: 1.4rem;
        color: #38bdf8;
      }

      .board-hud-texts {
        display: flex;
        flex-direction: column;
      }

      .board-hud-title {
        font-family: 'Inter', monospace;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        color: #38bdf8;
      }

      .board-hud-desc {
        font-size: 0.74rem;
        color: #cbd5e1;
      }

      .board-hud-actions {
        display: flex;
        gap: 8px;
      }

      .hud-pill-btn {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #f1f5f9;
        font-family: 'Inter', monospace;
        font-size: 0.70rem;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 9999px;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .hud-pill-btn:hover {
        background: rgba(255, 255, 255, 0.14);
        border-color: #38bdf8;
        color: #ffffff;
      }

      .hud-pill-close {
        background: rgba(239, 68, 68, 0.12);
        border-color: rgba(239, 68, 68, 0.35);
        color: #fca5a5;
      }

      .hud-pill-close:hover {
        background: rgba(239, 68, 68, 0.25);
        border-color: #ef4444;
        color: #ffffff;
      }

      /* Botón CTA Sección Final */
      .cta-container {
        padding-top: 10px;
      }

      .cta-button {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 14px 28px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 9999px;
        color: #ffffff;
        font-family: 'Inter', sans-serif;
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-decoration: none;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
        transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
      }

      .cta-button:hover {
        background: rgba(255, 255, 255, 0.16);
        border-color: rgba(255, 255, 255, 0.4);
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(147, 197, 253, 0.25);
      }

      .cta-arrow {
        transition: transform 0.3s ease;
      }

      .cta-button:hover .cta-arrow {
        transform: translateX(4px);
      }

      /* Indicador de Scroll Inferior */
      .scroll-indicator {
        position: fixed;
        bottom: 28px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        z-index: 20;
        cursor: pointer;
        user-select: none;
        transition: opacity 0.3s ease, transform 0.3s ease;
      }

      .scroll-indicator:hover {
        transform: translateX(-50%) translateY(-2px);
      }

      .mouse-icon {
        width: 18px;
        height: 28px;
        border: 1.5px solid rgba(255, 255, 255, 0.4);
        border-radius: 12px;
        position: relative;
        display: flex;
        justify-content: center;
      }

      .mouse-wheel {
        width: 2px;
        height: 6px;
        background: #ffffff;
        border-radius: 2px;
        position: absolute;
        top: 5px;
        animation: wheel-bounce 1.6s infinite ease-in-out;
      }

      @keyframes wheel-bounce {
        0%, 100% {
          transform: translateY(0);
          opacity: 1;
        }
        50% {
          transform: translateY(6px);
          opacity: 0.3;
        }
      }

      .scroll-arrows {
        display: flex;
        gap: 2px;
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.5);
      }

      .prompt-text {
        font-size: 0.68rem;
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
        text-align: center;
        white-space: nowrap;
      }

      .scroll-indicator.is-end .mouse-icon {
        border-color: var(--accent-blue);
      }

      .scroll-indicator.is-end .prompt-text {
        color: #f8fafc;
      }

      /* Pantalla de Carga (Loader) */
      #loader {
        position: fixed;
        inset: 0;
        background: var(--bg);
        display: grid;
        place-content: center;
        z-index: 100;
        transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.9s ease;
      }

      #loader.done {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      .loader-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 14px;
      }

      .loader-star {
        display: flex;
        align-items: center;
        justify-content: center;
        filter: drop-shadow(0 0 16px rgba(147, 197, 253, 0.35));
        animation: star-pulse 2.2s infinite ease-in-out;
      }

      .board-path {
        fill: #e2e8f0;
      }

      .board-path-1 {
        animation: board-blink-1 1.4s infinite ease-in-out;
      }

      .board-path-2 {
        animation: board-blink-2 1.4s infinite ease-in-out;
      }

      .board-path-3 {
        animation: board-blink-3 1.4s infinite ease-in-out;
      }

      @keyframes board-blink-1 {
        0%, 100% {
          fill: #f8fafc;
          opacity: 1;
        }
        50% {
          fill: #93c5fd;
          opacity: 0.25;
        }
      }

      @keyframes board-blink-2 {
        0%, 100% {
          fill: #93c5fd;
          opacity: 0.22;
        }
        50% {
          fill: #f8fafc;
          opacity: 1;
        }
      }

      @keyframes board-blink-3 {
        0%, 100% {
          fill: #fde68a;
          opacity: 0.95;
        }
        50% {
          fill: #93c5fd;
          opacity: 0.18;
        }
      }

      @keyframes star-pulse {
        0%, 100% {
          transform: scale(0.95);
        }
        50% {
          transform: scale(1.04);
        }
      }

      .loader-label {
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: #f8fafc;
      }

      .loader-bar {
        width: 190px;
        height: 2px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 2px;
        overflow: hidden;
      }

      #loader-fill {
        height: 100%;
        width: 0%;
        background: linear-gradient(90deg, #93c5fd, #ffffff);
        border-radius: 2px;
        transition: width 0.25s ease-out;
      }

      .loader-sub {
        font-size: 0.62rem;
        letter-spacing: 0.2em;
        color: var(--subtle);
      }

      /* Responsive Media Queries (Modo Móvil y Tablet con Piezas Centradas) */
      @media (max-width: 900px) {
        .story-section {
          padding-left: 0;
          padding-right: 0;
          padding-bottom: 95px;
          justify-content: center;
          align-items: flex-end;
        }

        .content-wrapper {
          max-width: 88vw;
          margin: 0 auto;
          align-items: center;
          text-align: center;
          background: radial-gradient(circle at center, rgba(3, 5, 8, 0.72) 0%, rgba(3, 5, 8, 0.25) 75%, transparent 100%);
          border-radius: 24px;
          padding: 16px 20px;
          backdrop-filter: blur(8px);
          -webkit-backdrop-filter: blur(8px);
        }

        .hero-title {
          font-size: clamp(2.4rem, 9.5vw, 3.8rem);
          text-align: center;
        }

        .hero-roles {
          max-width: 84vw;
          justify-content: center;
          gap: 6px;
        }

        .role-separator {
          display: none;
        }

        .role-badge {
          font-size: 0.72rem;
          padding: 4px 10px;
        }

        .hero-subtitle {
          max-width: 82vw;
          font-size: clamp(0.88rem, 3.5vw, 1.05rem);
          text-align: center;
        }

        .hero-links {
          justify-content: center;
          gap: 8px;
        }

        .social-pill {
          font-size: 0.72rem;
          padding: 6px 12px;
        }

        .section-kicker {
          text-align: center;
          font-size: 0.64rem;
        }

        .section-title {
          font-size: clamp(2.0rem, 7.8vw, 2.8rem);
          text-align: center;
        }

        .section-body {
          max-width: 82vw;
          font-size: clamp(0.88rem, 3.4vw, 1.05rem);
          text-align: center;
        }

        .pillar-list {
          max-width: 84vw;
          gap: 8px;
        }

        .pillar-item {
          text-align: left;
          padding: 9px 13px;
        }

        .skill-tags {
          max-width: 84vw;
          justify-content: center;
          gap: 6px;
        }

        .skill-chip {
          font-size: 0.62rem;
          padding: 3px 9px;
        }

        .king-clusters {
          max-width: 84vw;
          gap: 10px;
          align-items: center;
        }

        .king-group {
          width: 100%;
          padding: 10px 14px;
          align-items: center;
          text-align: center;
        }

        .king-pills {
          justify-content: center;
        }

        .king-pill {
          font-size: 0.70rem;
          padding: 4px 10px;
        }

        .king-quote {
          text-align: center;
          padding-left: 0;
          border-left: none;
          border-top: 1px solid rgba(224, 173, 80, 0.45);
          padding-top: 8px;
        }

        .project-list {
          max-width: 84vw;
          gap: 8px;
        }

        .project-card {
          padding: 10px 13px;
          text-align: left;
        }

        .project-desc {
          font-size: 0.74rem;
        }

        .project-footer {
          justify-content: center;
        }

        .tech-tag {
          text-align: center;
        }

        .brand-logo-btn {
          top: 16px;
          left: 16px;
          padding: 6px 12px;
        }

        .brand-monogram {
          font-size: 0.76rem;
        }

        .lang-toggle-btn {
          top: 16px;
          right: 16px;
          padding: 6px 12px;
          font-size: 0.68rem;
        }
      }
    </style>
  </body>
</html>
