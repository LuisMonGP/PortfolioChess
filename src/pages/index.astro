      function applyLanguage(lang: 'es' | 'en') {
        currentLang = lang;
        document.documentElement.lang = lang;
        const dict = I18N[lang];
        if (dict.page_title) document.title = dict.page_title;

        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
          const key = el.dataset.i18n!;
          if (dict[key] !== undefined) {
            el.textContent = dict[key];
          }
        });

        document.querySelectorAll<HTMLElement>('[data-i18n-html]').forEach((el) => {
          const key = el.dataset.i18nHtml!;
          if (dict[key] !== undefined) {
            el.innerHTML = dict[key];
          }
        });

        document.querySelectorAll<HTMLElement>('#lang-toggle .lang-opt').forEach((opt) => {
          opt.classList.toggle('active', opt.dataset.langCode === lang);
        });

        promptLabel.textContent = PROMPTS_I18N[lang][currentActiveIdx];
      }

      const langToggleBtn = document.getElementById('lang-toggle');
      if (langToggleBtn) {
        langToggleBtn.addEventListener('click', () => {
          applyLanguage(currentLang === 'es' ? 'en' : 'es');
        });
      }

      const brandLogoBtn = document.getElementById('brand-logo');
      if (brandLogoBtn) {
        brandLogoBtn.addEventListener('click', () => {
          lenis.scrollTo(0, { duration: 1.4 });
        });
      }

      let isLoaded = false;

      chess
        .init((progress) => {
          fill.style.width = `${Math.round(progress * 100)}%`;
        })
        .then(() => {
          isLoaded = true;
          chess.start();
          loader.classList.add('done');
          requestAnimationFrame(() => lenis.resize());
        })
        .catch((err) => {
          console.error('Error cargando Three.js:', err);
          const lbl = loader.querySelector('.loader-label');
          if (lbl) lbl.textContent = 'ERROR AL CARGAR ASSETS 3D';
        });

      // Loop de sincronización Lenis + Three.js
      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);

      // Evento de scroll
      lenis.on('scroll', ({ progress }: { progress: number }) => {
        if (!isLoaded) return;

        chess.setScrollProgress(progress);

        // Determinar sección activa por progreso [0..1] entre las 9 secciones
        const activeIdx = Math.min(
          sections.length - 1,
          Math.max(0, Math.floor(progress * (sections.length - 1) + 0.5))
        );
        currentActiveIdx = activeIdx;

        // Actualizar visibilidad de secciones
        sections.forEach((sec, idx) => {
          sec.classList.toggle('active', idx === activeIdx);
        });

        // Actualizar indicador de scroll inferior
        promptLabel.textContent = PROMPTS_I18N[currentLang][activeIdx];
        scrollPrompt.classList.toggle('is-end', activeIdx === sections.length - 1);
      });

      // Click en el indicador inferior (si está al final, vuelve arriba)
      scrollPrompt.addEventListener('click', () => {
        if (scrollPrompt.classList.contains('is-end')) {
          lenis.scrollTo(0, { duration: 1.6 });
        } else {
          lenis.scrollTo(window.scrollY + window.innerHeight * 0.9, { duration: 1.0 });
        }
      });

      // Copiar correo al portapapeles con feedback visual interactivo
      const copyBtn = document.getElementById('copy-email-btn') as HTMLButtonElement | null;
      if (copyBtn) {
        let timer: any;
        copyBtn.addEventListener('click', async () => {
          const email = copyBtn.dataset.email || 'monjeje2028@gmail.com';
          try {
            await navigator.clipboard.writeText(email);
          } catch {
            const temp = document.createElement('textarea');
            temp.value = email;
            document.body.appendChild(temp);
            temp.select();
            document.execCommand('copy');
            document.body.removeChild(temp);
          }

          copyBtn.classList.add('copied');
          const hint = copyBtn.querySelector('.copy-hint');
          const label = copyBtn.querySelector('.email-label');
          if (hint) hint.textContent = I18N[currentLang].copied_hint;
          if (label) label.textContent = I18N[currentLang].copied_label;

          clearTimeout(timer);
          timer = setTimeout(() => {
            copyBtn.classList.remove('copied');
            if (hint) hint.textContent = I18N[currentLang].copy_hint;
            if (label) label.textContent = email;
          }, 2400);
        });
      }
